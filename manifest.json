
{
  "manifest_version": 3,
  "name": "Website Blocker",
  "version": "1.1",
  "description": "Block websites or specific pages",
  "permissions": [
    "storage",
    "declarativeNetRequest"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
